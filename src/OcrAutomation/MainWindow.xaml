<Window x:Class="OcrAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OcrAutomation"
        mc:Ignorable="d"
        Title="OCR Automation" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚙" FontSize="22" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="OCR AUTOMATION" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="v2.1" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Confidence, StringFormat='{}{0:P0}'}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{Binding Confidence, Converter={StaticResource ConfidenceToColorConverter}}"/>
                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10,4">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource MutedBrush}" FontStyle="Italic"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Command bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Capture Window" Command="{Binding CaptureWindowCommand}" Style="{StaticResource BtnPrimary}"/>
            <Button Content="Import" Command="{Binding ImportFileCommand}" Style="{StaticResource BtnPrimary}"/>
            <Button Content="Run OCR" Command="{Binding RunOcrCommand}" Style="{StaticResource BtnPrimary}"/>
            <Button Content="Capture Region" Command="{Binding CaptureRegionCommand}" Style="{StaticResource BtnGhost}"/>
            <Button Content="Refresh" Command="{Binding RefreshWindowsCommand}" Style="{StaticResource BtnGhost}"/>
            <Button Content="To Rows" Command="{Binding ArrangeRowsCommand}" Style="{StaticResource BtnGhost}"/>
            <Button Content="Save Raster" Command="{Binding SaveRasterCommand}" Style="{StaticResource BtnGhost}"/>
            <Button Content="Automate" Command="{Binding RunAutomationCommand}" Style="{StaticResource BtnGhost}"/>
            <Button Content="Copy" Command="{Binding CopyToClipboardCommand}" Style="{StaticResource BtnGhost}"/>
            <Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource BtnGhost}"/>
        </StackPanel>

        <!-- Selectors -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="Engine" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding OcrEngineOptions}" SelectedItem="{Binding SelectedOcrEngine, Mode=TwoWay}" Width="180" Style="{StaticResource DarkCombo}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Target" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding AvailableWindows}" SelectedItem="{Binding SelectedWindow}"
                          DisplayMemberPath="Title" MinWidth="220" MaxWidth="420" Style="{StaticResource DarkCombo}"/>
                <TextBlock Text="DPI" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <ComboBox ItemsSource="{Binding RenderDpiOptions}" SelectedItem="{Binding SelectedRenderDpi, Mode=TwoWay}" Width="90" Style="{StaticResource DarkCombo}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            Visibility="{Binding HasPdf, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="‹" Command="{Binding PdfPrevCommand}" Style="{StaticResource BtnGhost}" Padding="10,2" FontSize="14"/>
                    <TextBlock Text="{Binding PdfPageInfo}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,8,0"/>
                    <Button Content="›" Command="{Binding PdfNextCommand}" Style="{StaticResource BtnGhost}" Padding="10,2" FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Main cards -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CAPTURE" Style="{StaticResource CardTitle}"/>
                    <Border Grid.Row="1" Background="#0B1220" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Image Source="{Binding CapturedImage}" Stretch="Uniform" Margin="4"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="TEXT" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" Margin="0,0,0,0"/>
                        <Button Content="📋 Copy" Command="{Binding CopyToClipboardCommand}" Style="{StaticResource BtnGhost}" DockPanel.Dock="Right" Padding="8,2" FontSize="12" Margin="0,0,0,0"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" Text="{Binding OcrText, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkText}" BorderThickness="0" Background="Transparent"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="RULES" Style="{StaticResource CardTitle}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding MappingRules}" Style="{StaticResource DarkGrid}" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="45"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Load" Command="{Binding LoadMappingsCommand}" Style="{StaticResource BtnGhost}" Padding="12,4"/>
                        <Button Content="Save" Command="{Binding SaveMappingsCommand}" Style="{StaticResource BtnGhost}" Padding="12,4"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Log -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="LOG" Style="{StaticResource CardTitle}"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" Style="{StaticResource DarkList}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
